# Copy this file to docker/.env and customize values
# Minimal: provide at least one provider API key OR configure local models

# === Provider API Keys (pick any you use) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# === Local OpenAI-compatible endpoint (optional) ===
# e.g., FastAPI server exposing /v1
LOCAL_OPENAI_BASE=
LOCAL_OPENAI_API_KEY=

# === VLLM endpoint (optional, OpenAI-compatible /v1) ===
VLLM_BASE_URL=
VLLM_API_KEY=

# === Proxy (LiteLLM) ===
# Only needed when using docker-compose.proxy.yml
# Defaults are set inside the compose file; override if desired
BYTEBOT_LLM_PROXY_URL=

# === Internal URLs (normally do not change) ===
# Desktop service base URL used by the agent
BYTEBOT_DESKTOP_BASE_URL=http://bytebot-desktop:9990

# === Database (defaults match compose) ===
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bytebotdb

# === Google OAuth for Calendar ===
# Create OAuth 2.0 Client ID (Web) in Google Cloud Console and set the following:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect must match this value or set your own and update compose:
GOOGLE_OAUTH_REDIRECT=http://localhost:9991/api/google/oauth/callback
# Comma-separated scopes; default grants full Calendar access
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar
# Path inside container where OAuth tokens are stored (persisted via ./data volume)
GOOGLE_TOKEN_PATH=/data/google_tokens.json
# Timezone used by the agent to interpret natural time ranges (IANA tz name)
AGENT_TIMEZONE=America/Los_Angeles
